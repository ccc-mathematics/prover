-- 範例 1: 恆等律 (A -> A)
theorem id : Pi A:Prop, A -> A := by
  intro A
  intro x
  exact x
qed

-- 範例 2: 假言三段論 (傳遞性)
theorem syllogism : Pi P:Prop, Pi Q:Prop, Pi R:Prop, (P -> Q) -> (Q -> R) -> (P -> R) := by
  intro P
  intro Q
  intro R
  intro h1
  intro h2
  intro hp
  apply h2
  apply h1
  exact hp
qed

-- 範例 3: 依值型別 (全稱實例化 Modus Ponens)
theorem forall_elim : Pi Dom:Type, Pi P:(Dom -> Prop), Pi x:Dom, (Pi y:Dom, P y) -> P x := by
  intro Dom
  intro P
  intro x
  intro h
  apply h
qed
